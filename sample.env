# Read by docker-compose.yml (docker compose looks for a .env file next to the
# compose file, i.e. at the repository root) to configure the local Postgres
# container. These are infra/compose-only values, not application settings --
# see apps/cloud-api/sample.env and apps/desktop/engine/sample.env for those.
POSTGRES_USER=cristian
POSTGRES_PASSWORD=
POSTGRES_DB=nutrition_toolkit
