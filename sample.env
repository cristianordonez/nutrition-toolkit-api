# Repository-root .env. Copy to `.env` and fill in.
#
# This one file is read by two different consumers, which is why it mixes
# infrastructure and application settings:
#
#   1. docker compose, which looks for a .env next to docker-compose.yml and
#      interpolates the ${...} references in it. Everything under "Compose"
#      below exists for that.
#
#   2. Any engine or server process you run from the repository root.
#      `ntk.models.base.get_env_file()` resolves $NTK_CONFIG_FILE, or falls
#      back to `<cwd>/.env` -- so a command run from the root reads this file.
#      To keep an app's settings separate instead, copy its own sample.env and
#      point NTK_CONFIG_FILE at the result.
#
# Never committed: .gitignore excludes it and .dockerignore keeps it out of the
# image, so the container gets these values from compose rather than from a
# baked-in file.

# ---------------------------------------------------------------- Compose ---
# Credentials for the Postgres container. Compose substitutes these into both
# the db service and the connection strings it passes to migrate and server,
# so they must be set -- there are no defaults, and a missing one yields an
# empty value rather than an error.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nutrition_toolkit

# Passed through to the server and migrate containers. Required: server
# calls OpenAI to generate notes.
NTK_OPEN_AI_API_KEY=

# Optional. logfire.configure() raises at import when it finds no credentials,
# which a container never has. "if-token-present" sends traces only when a
# token is supplied and stays quiet otherwise; set a token to enable tracing.
# LOGFIRE_SEND_TO_LOGFIRE=if-token-present
# LOGFIRE_TOKEN=

# ------------------------------------------- Desktop engine, run from root ---
# Only needed when you run `uv run --package engine engine ...` from here.
# See apps/desktop/engine/sample.env for the full set and their defaults.

# Where server is reachable. Note generation runs there and has no
# on-device fallback.
NTK_SERVER_BASE_URL=http://localhost:8000
# Bearer token for server. Mint one with `tox -e api-key`.
NTK_SERVER_API_KEY=

NTK_DEBUG=true
