# Settings for apps/desktop/engine. Every key maps to a field on
# `engine.models.settings.Settings`, with the NTK_ prefix.
#
# The engine resolves its config file as $NTK_CONFIG_FILE, or `<cwd>/.env`
# otherwise. The Tauri shell points NTK_CONFIG_FILE here when this directory
# contains a `.env`, and falls back to the repository-root .env when it does
# not -- so copy this file to `.env` beside it to keep the desktop app's
# settings separate from the compose stack's.

# --------------------------------------------------------------- Required ---

# Used for document extraction. Optional only when NTK_USE_LOCAL_EXTRACTION
# is true, which runs extraction through Ollama instead.
NTK_OPEN_AI_API_KEY=

# ------------------------------------------------------ Note generation -----
# Notes are generated by cloud-api and nowhere else: the diet and
# nutrition-care manual lookups search a pgvector knowledge base that exists
# only there, so there is deliberately no on-device note agent. Generation
# fails with a clear error when cloud-api is unreachable rather than falling
# back to a note quietly missing those lookups.

NTK_CLOUD_API_BASE_URL=http://localhost:8000
# Bearer token. Mint one with `tox -e api-key`; without it cloud-api
# answers 401.
NTK_CLOUD_API_KEY=

# ------------------------------------------------- Document extraction ------

NTK_DOCUMENT_INGESTION_POOL_MODE=thread
NTK_DOCUMENT_INGESTION_WORKERS=3
NTK_CLINICAL_NOTE_EXTRACTION_CONCURRENCY=8

# Run extraction on-device via Ollama instead of OpenAI. Unlike note
# generation, extraction genuinely can run locally -- it needs no knowledge
# base.
NTK_USE_LOCAL_EXTRACTION=false
NTK_OLLAMA_HOST=http://localhost:11434
# Override the on-device model. Leave unset to let the app choose.
# NTK_OLLAMA_MODEL=
# Seam for a future bundled model; unused today.
NTK_LOCAL_MODEL_PATH=

# ------------------------------------------------------------- Storage ------
# Leave unset to use the platform's application directories:
#   macOS   ~/Library/Application Support/NutritionToolkit (logs in ~/Library/Logs)
#   Linux   ~/.local/share/NutritionToolkit (logs in ~/.local/state)
#   Windows %LOCALAPPDATA%\NutritionToolkit
#
# facts.db is this device's system of record for every person and clinical
# record. It is the only place that data lives -- cloud-api never stores it.
# NTK_FACTS_DATABASE_PATH=
# NTK_SETTINGS_DATABASE_PATH=
# NTK_LOG_FILE=

NTK_DEBUG=true
