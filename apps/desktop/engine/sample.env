NTK_OPEN_AI_API_KEY=
NTK_DEBUG=true
NTK_DOCUMENT_INGESTION_POOL_MODE=thread
NTK_DOCUMENT_INGESTION_WORKERS=3
NTK_CLINICAL_NOTE_EXTRACTION_CONCURRENCY=8
NTK_CLOUD_API_BASE_URL=http://localhost:8000
# Bearer token for cloud-api. Required for note generation unless
# NTK_USE_LOCAL_GENERATION=true.
NTK_CLOUD_API_KEY=
# Generate notes in-process instead of calling cloud-api. Development and
# offline only: generation belongs cloud-side, and running it locally
# loses the diet and nutrition-care manual lookups.
NTK_USE_LOCAL_GENERATION=false
# Run document extraction on-device via Ollama instead of OpenAI.
NTK_USE_LOCAL_EXTRACTION=false
NTK_OLLAMA_HOST=http://localhost:11434
# Leave these unset to use the platform's application directories:
#   macOS   ~/Library/Application Support/NutritionToolkit (logs in ~/Library/Logs)
#   Linux   ~/.local/share/NutritionToolkit (logs in ~/.local/state)
#   Windows %LOCALAPPDATA%\NutritionToolkit
# NTK_FACTS_DATABASE_PATH=
# NTK_SETTINGS_DATABASE_PATH=
# NTK_LOG_FILE=
NTK_LOCAL_MODEL_PATH=
