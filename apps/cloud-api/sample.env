# Settings for apps/cloud-api. Every key maps to a field on
# `api.models.settings.Settings`, with the NTK_ prefix.
#
# You usually do NOT need this file. Running the stack with `tox -e up` passes
# these values in from docker-compose.yml, which reads the repository-root
# .env. Copy this one only to run the server directly on the host -- then
# either run from this directory or point NTK_CONFIG_FILE at your copy.

# --------------------------------------------------------------- Required ---
# No defaults. The server fails to start without them.

# Full Postgres connection string. Must use the psycopg driver.
# Example: postgresql+psycopg://user:password@localhost:5432/nutrition_toolkit
NTK_DATABASE_URL=

# Example: redis://localhost:6379/0
NTK_REDIS_DSN=

# Used to generate Nutrition Care Process notes.
NTK_OPEN_AI_API_KEY=

# --------------------------------------------------------------- Optional ---
# Shown with their defaults.

NTK_PORT=8000
NTK_DEBUG=false

# SQLAlchemy connection pool sizing.
NTK_POOL_SIZE=50
NTK_MAX_OVERFLOW=100

# Tracing. logfire.configure() raises at import when it finds no credentials,
# so outside a developer machine that has run `uv run logfire auth`, set
# LOGFIRE_SEND_TO_LOGFIRE to keep it quiet. These two are read by logfire
# itself and take no NTK_ prefix.
# LOGFIRE_SEND_TO_LOGFIRE=if-token-present
# LOGFIRE_TOKEN=
